<?xml version="1.0" encoding="utf-8"?>
<!--
  Protección local (Android 12+): los datos de la app no se copian a la nube de
  Google ni a otro dispositivo. Así una sesión de Firebase o la base de Room no
  se restauran en un equipo distinto. Los recordatorios se recuperan desde
  Firestore al iniciar sesión.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
